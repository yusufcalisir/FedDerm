# ── ML / Research outputs (large, reproducible from code) ──────────────────────
results/
outputs/
checkpoints/
runs/
wandb/
mlruns/
*.pt
*.pth
*.ckpt
*.safetensors
# Exception: keep small reference artifacts if explicitly committed
!results/.gitkeep
!checkpoints/.gitkeep

# ── Data (download via scripts, never commit raw data) ─────────────────────────
data/
!data/.gitkeep

# ── Notebooks (strip outputs before committing; keep .ipynb structure) ─────────
# Jupyter checkpoints
.ipynb_checkpoints/
